# PostgreSQL values used by Docker Compose.
POSTGRES_DB=plant_guardian
POSTGRES_USER=plant_guardian
POSTGRES_PASSWORD=replace_with_a_long_random_password

# Backend configuration.
# For a host-run backend, use localhost as the database host.
DATABASE_URL=postgresql+psycopg://plant_guardian:replace_with_a_long_random_password@localhost:5432/plant_guardian
APP_ENV=development
CORS_ORIGINS=http://localhost:3000
AUTO_SEED=true
SEED_STARTER_PLANTS=false
SESSION_LIFETIME_DAYS=7

# Google Identity Services (optional). Use the same client ID for backend and frontend.
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Browser push notifications. Generate a VAPID pair with:
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
NOTIFICATION_DISPATCH_TOKEN=replace_with_a_long_random_value

# Optional GCP Pub/Sub mode. Leave these blank for local Docker Compose;
# reminders are delivered directly by the backend in local mode.
GCP_PROJECT_ID=
PUBSUB_NOTIFICATION_TOPIC=
PUBSUB_PUSH_SERVICE_ACCOUNT=
PUBSUB_PUSH_AUDIENCE=
SCHEDULER_SERVICE_ACCOUNT=
SCHEDULER_AUDIENCE=

# Server-side URLs used by the Next.js same-origin API proxy.
API_URL=http://localhost:8000
VACATION_API_URL=http://localhost:8002

# AI Care Assistant (Groq).
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.1-8b-instant

# Vacation Mode -> AI Care Assistant (used when running services outside Compose).
AI_ASSISTANCE_URL=http://localhost:8001
