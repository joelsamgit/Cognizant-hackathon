# PostgreSQL values used by Docker Compose.
POSTGRES_DB=plant_guardian
POSTGRES_USER=plant_guardian
POSTGRES_PASSWORD=asdbahbswibefbbIOISNFDONINnskd

# Backend configuration.
# For a host-run backend, use localhost as the database host.
DATABASE_URL=postgresql+psycopg://plant_guardian:replace_with_a_long_random_password@localhost:5432/plant_guardian
APP_ENV=development
CORS_ORIGINS=http://localhost:3000
AUTO_SEED=true

# Server-side URLs used by the Next.js same-origin API proxy.
API_URL=http://localhost:8000
VACATION_API_URL=http://localhost:8002

# AI Care Assistant (Groq).
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.1-8b-instant

# Vacation Mode -> AI Care Assistant (used when running services outside Compose).
AI_ASSISTANCE_URL=http://localhost:8001
